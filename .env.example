# ============================================================================
# EA-Hub (self-hosted) — settings for docker-compose.yml
# إعدادات EA-Hub للاستضافة الذاتية
#
# الأسهل: شغّل ./setup.sh (أو .\setup.ps1 على ويندوز)، فهو يسألك ويكتب ملف .env تلقائياً.
# Easiest: run ./setup.sh (or .\setup.ps1) — it asks you and writes .env for you.
#
# لا ترفع ملف .env إلى أي مستودع: فيه كلمات مرور. Never commit .env.
# ============================================================================

# --- Address / العنوان -------------------------------------------------------
# The exact address people type in the browser (no trailing slash).
# الرابط الذي يكتبه المستخدمون في المتصفح، مثل https://hub.example.com أو http://192.168.1.10
APP_URL=http://localhost
# What Caddy serves: your domain (automatic HTTPS) or :80 for plain HTTP.
# اسم النطاق للحصول على HTTPS مجاناً وتلقائياً، أو :80 للعمل بدون HTTPS داخل الشبكة.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# --- First admin / حساب المدير الأول -----------------------------------------
# Created on first start only. After you sign in you can delete ADMIN_PASSWORD from this file.
# يُنشأ عند أول تشغيل فقط. بعد أول دخول يمكنك حذف ADMIN_PASSWORD من هذا الملف.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Set to true once (then back to false) to replace the admin password with ADMIN_PASSWORD.
ADMIN_RESET_PASSWORD=false

# --- Secrets (generated by setup) / أسرار تُولَّد تلقائياً ---------------------------
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Root key for encrypting saved keys and signing sessions (48+ random characters).
# لا تغيّره بعد التشغيل وإلا ستنتهي الجلسات وتُفقد المفاتيح المحفوظة المشفرة.
APP_ENCRYPTION_KEY=
CRON_SECRET=

# --- E-mail (optional) / البريد (اختياري) -----------------------------------
# Needed for "forgot password", request notifications and the newsletter.
# مطلوب لاستعادة كلمة المرور وإشعارات الطلبات والنشرة البريدية.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (SSL); leave empty for 587/25 (STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="EA-Hub <no-reply@example.com>"
NOTIFY_FROM=
NEWSLETTER_FROM=
# Alternative to SMTP: a Resend API key (https://resend.com)
RESEND_API_KEY=

# --- Optional features (on only when a key is set) / ميزات اختيارية -----------
# Search by meaning (OpenAI embeddings). البحث الدلالي.
OPENAI_API_KEY=
# AI assistant provider. مزود المساعد الذكي (يمكن ضبطه أيضاً من لوحة الإدارة).
GROQ_API_KEY=
# Cloudflare Turnstile bot protection (both or neither). حماية من البوتات.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Advanced / متقدم -------------------------------------------------------
POSTGRES_DB=eahub
# Image to run. Build locally instead with: docker compose build
EA_HUB_IMAGE=ghcr.io/e20e-tools/ea-hub-selfhost:latest
# Build without the ~120 MB local search model: WITH_LOCAL_MODEL=0
WITH_LOCAL_MODEL=1
STORAGE_MAX_UPLOAD_MB=10

# Where uploaded files are kept: filesystem (the storage-data volume, default) or s3
# (AWS S3 or any S3-compatible service: MinIO, Ceph, Cloudflare R2, Wasabi…).
# With s3, back up the bucket with versioning or replication: the nightly backup then
# contains the database only.
# Single sign-on with OpenID Connect (Entra ID, Keycloak, Okta, Google, Authentik…).
# Register the redirect URI <APP_URL>/api/selfhost/auth/oidc/callback at the provider.
# Admin rights go only to the listed e-mails / groups. See docs/en/single-sign-on.md.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_BUTTON_LABEL=Sign in with your organisation account
OIDC_ADMIN_EMAILS=
OIDC_ADMIN_GROUPS=
OIDC_GROUPS_CLAIM=groups
OIDC_ALLOWED_DOMAINS=
OIDC_AUTO_CREATE=false
OIDC_REQUIRE_VERIFIED_EMAIL=true

STORAGE_BACKEND=filesystem
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# PostgreSQL image for the db and backup services. Change the MAJOR version only with
# selfhost/scripts/pg-major-upgrade.sh (it moves the data); minor updates are automatic.
POSTGRES_IMAGE=postgres:16-alpine
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=1
# A backup is also taken before the database migrations of every start/upgrade (0 = off).
BACKUP_BEFORE_MIGRATE=1

# Optional: copy backups off this server every hour (rclone). Turn on with:
#   COMPOSE_PROFILES=offsite
# S3 / MinIO / Wasabi / Cloudflare R2: OFFSITE_TYPE=s3, OFFSITE_PROVIDER=AWS|Minio|Other,
#   OFFSITE_REGION, OFFSITE_ENDPOINT (non-AWS), OFFSITE_ACCESS_KEY_ID, OFFSITE_SECRET_ACCESS_KEY
# Azure Blob: OFFSITE_TYPE=azureblob, OFFSITE_AZURE_ACCOUNT, OFFSITE_AZURE_KEY
# OFFSITE_PATH = bucket/folder (or container/folder). Retention: use the bucket's lifecycle rules.
COMPOSE_PROFILES=
OFFSITE_PATH=
OFFSITE_TYPE=s3
OFFSITE_PROVIDER=AWS
OFFSITE_REGION=
OFFSITE_ENDPOINT=
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
OFFSITE_AZURE_ACCOUNT=
OFFSITE_AZURE_KEY=

# Prometheus metrics at /metrics (Authorization: Bearer <token>). Empty = disabled.
METRICS_TOKEN=
