# EA-Hub environment variables. Copy to .env (never commit .env) or set them in Vercel.
# Local runs (npm start / npm run dev) need none of these: scripts/local.mjs sets the
# Supabase values for the embedded local backend.
#
# Legend: [public] is safe in the browser bundle. [secret] stays server-side only.

# --- Supabase (required) ---------------------------------------------------------------
# Browser build: inlined by Vite at build time.
VITE_SUPABASE_URL=https://your-project.supabase.co              # [public]
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx                  # [public]
# Server runtime.
SUPABASE_URL=https://your-project.supabase.co                     # [public]
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx                       # [public]
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx                           # [secret] bypasses RLS

# Direct Postgres connection for the newsletter and team trials. Use a least-privilege
# role, not the postgres superuser. Without it those two features report "unavailable".
POSTGRES_URL=postgres://user:password@host:6543/postgres          # [secret]

# Root secret for encrypting saved AI keys and signing visitor tokens (HKDF subkeys).
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# When unset, the service-role key is used instead; set this so rotating that key
# does not invalidate saved secrets.
APP_ENCRYPTION_KEY=                                               # [secret]

# --- Scheduled jobs (Vercel Cron sends `Authorization: Bearer $CRON_SECRET`) -----------
CRON_SECRET=                                                      # [secret]
CRON_SECRET_PREVIOUS=                                             # [secret] optional, during rotation

# --- AI assistant (optional: without a key Archy uses the local model when available) --
GROQ_API_KEY=                                                     # [secret]
# Search by meaning (site search + Archy context). Sent to api.openai.com only; unset = off.
OPENAI_API_KEY=                                                   # [secret]

# --- Bot protection (optional; both or neither) ----------------------------------------
TURNSTILE_SITE_KEY=                                               # [public]
TURNSTILE_SECRET_KEY=                                             # [secret]

# --- Newsletter e-mail via Resend (optional) -------------------------------------------
RESEND_API_KEY=                                                   # [secret]
NEWSLETTER_FROM="E20E <news@example.com>"
NEWSLETTER_ORIGIN=https://www.e20e.tools
NEWSLETTER_MONTHLY_ENABLED=false
# Sender for customer notices (request replies etc.); falls back to NEWSLETTER_FROM.
NOTIFY_FROM="E20E <support@example.com>"

# --- Migrations (drizzle-kit only, your machine) ---------------------------------------
DATABASE_MIGRATION_URL=                                           # [secret]

# --- Local-only, set by scripts/local.mjs. Never set these in production. -------------
# EA_LOCAL_SEMANTIC=file:///.../local-backend/semantic.mjs
# EA_LOCAL_DESIGN_LAB=/.../design-lab.html
