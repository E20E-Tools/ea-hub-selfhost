# ============================================================================
# EA-Hub (self-hosted) — settings for docker-compose.yml
# إعدادات EA-Hub للاستضافة الذاتية
#
# الأسهل: شغّل ./setup.sh (أو .\setup.ps1 على ويندوز)، فهو يسألك ويكتب ملف .env تلقائياً.
# Easiest: run ./setup.sh (or .\setup.ps1) — it asks you and writes .env for you.
#
# لا ترفع ملف .env إلى أي مستودع: فيه كلمات مرور. Never commit .env.
# ============================================================================

# --- Address / العنوان -------------------------------------------------------
# The exact address people type in the browser (no trailing slash).
# الرابط الذي يكتبه المستخدمون في المتصفح، مثل https://hub.example.com أو http://192.168.1.10
APP_URL=http://localhost
# What Caddy serves: your domain (automatic HTTPS) or :80 for plain HTTP.
# اسم النطاق للحصول على HTTPS مجاناً وتلقائياً، أو :80 للعمل بدون HTTPS داخل الشبكة.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# --- First admin / حساب المدير الأول -----------------------------------------
# Created on first start only. After you sign in you can delete ADMIN_PASSWORD from this file.
# يُنشأ عند أول تشغيل فقط. بعد أول دخول يمكنك حذف ADMIN_PASSWORD من هذا الملف.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Set to true once (then back to false) to replace the admin password with ADMIN_PASSWORD.
ADMIN_RESET_PASSWORD=false

# --- Secrets (generated by setup) / أسرار تُولَّد تلقائياً ---------------------------
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Root key for encrypting saved keys and signing sessions (48+ random characters).
# لا تغيّره بعد التشغيل وإلا ستنتهي الجلسات وتُفقد المفاتيح المحفوظة المشفرة.
APP_ENCRYPTION_KEY=
CRON_SECRET=

# --- E-mail (optional) / البريد (اختياري) -----------------------------------
# Needed for "forgot password", request notifications and the newsletter.
# مطلوب لاستعادة كلمة المرور وإشعارات الطلبات والنشرة البريدية.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (SSL); leave empty for 587/25 (STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="EA-Hub <no-reply@example.com>"
NOTIFY_FROM=
NEWSLETTER_FROM=
# Alternative to SMTP: a Resend API key (https://resend.com)
RESEND_API_KEY=

# --- Optional features (on only when a key is set) / ميزات اختيارية -----------
# Search by meaning (OpenAI embeddings). البحث الدلالي.
OPENAI_API_KEY=
# AI assistant provider. مزود المساعد الذكي (يمكن ضبطه أيضاً من لوحة الإدارة).
GROQ_API_KEY=
# Cloudflare Turnstile bot protection (both or neither). حماية من البوتات.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Advanced / متقدم -------------------------------------------------------
POSTGRES_DB=eahub
# Image to run. Build locally instead with: docker compose build
EA_HUB_IMAGE=ghcr.io/e20e-tools/ea-hub-selfhost:latest
# Build without the ~120 MB local search model: WITH_LOCAL_MODEL=0
WITH_LOCAL_MODEL=1
STORAGE_MAX_UPLOAD_MB=10
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=1
