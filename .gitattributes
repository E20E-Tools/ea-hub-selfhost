* text=auto eol=lf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.webp binary
*.mp4 binary
*.webm binary
*.glb binary
*.ttf binary
*.otf binary
*.pdf binary

# --- Self-host ---
# Files that replace upstream ones: on upstream sync keep our version
# (the sync workflow sets `git config merge.ours.driver true`).
README.md merge=ours
.env.example merge=ours
Dockerfile merge=ours
.dockerignore merge=ours
docker-compose.yml merge=ours
*.sh text eol=lf
