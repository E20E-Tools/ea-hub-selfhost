{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "EA-Hub Helm values",
  "type": "object",
  "required": ["appUrl", "image", "secrets", "postgres", "storage"],
  "properties": {
    "appUrl": {
      "type": "string",
      "pattern": "^https?://[^/\\s]+(/[^\\s]*)?$",
      "description": "Address people open in the browser, e.g. https://hub.example.com"
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object", "required": ["name"] } },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "admin": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "anyOf": [{ "maxLength": 0 }, { "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$" }]
        },
        "password": { "type": "string", "anyOf": [{ "maxLength": 0 }, { "minLength": 10 }] },
        "resetPassword": { "type": "boolean" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "postgresPassword": { "type": "string" },
        "appDbPassword": { "type": "string" },
        "appEncryptionKey": { "type": "string", "anyOf": [{ "maxLength": 0 }, { "minLength": 32 }] },
        "cronSecret": { "type": "string", "anyOf": [{ "maxLength": 0 }, { "minLength": 16 }] }
      }
    },
    "sso": {
      "type": "object",
      "properties": {
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": { "type": "string", "pattern": "^$|^https?://" },
            "clientId": { "type": "string" },
            "clientSecret": { "type": "string" },
            "scopes": { "type": "string" },
            "buttonLabel": { "type": "string" },
            "adminEmails": { "type": "string" },
            "adminGroups": { "type": "string" },
            "groupsClaim": { "type": "string" },
            "autoCreate": { "type": "boolean" },
            "requireVerifiedEmail": { "type": "boolean" }
          }
        }
      }
    },
    "smtp": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "secure": { "type": "boolean" },
        "user": { "type": "string" },
        "password": { "type": "string" },
        "from": { "type": "string" }
      }
    },
    "mail": {
      "type": "object",
      "properties": {
        "resendApiKey": { "type": "string" },
        "notifyFrom": { "type": "string" },
        "newsletterFrom": { "type": "string" }
      }
    },
    "features": {
      "type": "object",
      "properties": {
        "openaiApiKey": { "type": "string" },
        "groqApiKey": { "type": "string" },
        "turnstileSiteKey": { "type": "string" },
        "turnstileSecretKey": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "tls": { "type": "boolean" },
        "tlsSecretName": { "type": "string" },
        "annotations": { "type": "object" }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "properties": { "host": { "minLength": 1 } } }
    },
    "openshift": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "route": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "host": { "type": "string" },
            "tls": { "type": "boolean" },
            "annotations": { "type": "object" }
          }
        }
      }
    },
    "trustProxyHops":{ "type": "integer", "minimum": 0, "maximum": 5 },
    "storage": {
      "type": "object",
      "properties": {
        "backend": { "type": "string", "enum": ["filesystem", "s3"] },
        "s3": {
          "type": "object",
          "properties": {
            "bucket": { "type": "string" },
            "region": { "type": "string" },
            "endpoint": { "type": "string", "pattern": "^$|^https?://" },
            "forcePathStyle": { "type": "string", "enum": ["", "true", "false"] },
            "prefix": { "type": "string" },
            "accessKeyId": { "type": "string" },
            "secretAccessKey": { "type": "string" }
          }
        },
        "size": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessMode": { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod"] },
        "existingClaim": { "type": "string" },
        "maxUploadMb": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "database": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "storage": { "type": "object" },
        "resources": { "type": "object" }
      }
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "database": { "type": "string" },
        "adminUser": { "type": "string" },
        "sslmode": { "type": "string", "enum": ["", "disable", "prefer", "require", "verify-ca", "verify-full"] }
      }
    },
    "migrate": { "type": "object" },
    "cron": { "type": "object" },
    "backup": {
      "type": "object",
      "properties": {
        "offsite": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "type": "string", "minLength": 1 },
            "path": { "type": "string" },
            "config": {
              "type": "object",
              "additionalProperties": { "type": ["string", "boolean", "number"] }
            },
            "credentials": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "existingSecret": { "type": "string" }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "labels": { "type": "object" }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressNamespaceSelectors": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "resources": { "type": "object" },
    "podAnnotations": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  }
}
